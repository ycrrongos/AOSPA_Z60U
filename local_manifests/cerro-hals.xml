<?xml version="1.0" encoding="UTF-8"?>
<!--
  AOSPA calcite — cerro Lineage CAF HAL 缺口（对照 OnlyAOSP cerro-hals.xml 后裁剪）。

  AOSPA 已有、禁止覆盖：
    hardware/qcom/{bootctrl,wlan,thermal→opensource}
    device/qcom/sepolicy_vndr
    vendor/qcom/opensource/{usb,power,vibrator,data-ipa-cfg-mgr,dataipa,commonsys*}
    hardware/lineage/compat

  仅补 Lineage DT 硬编码的 hardware/qcom-caf/* 路径 + sepolicy/interfaces。
-->
<manifest>
  <remote name="github" fetch="https://github.com" />

  <project path="device/lineage/sepolicy"
           name="LineageOS/android_device_lineage_sepolicy"
           remote="github"
           revision="lineage-24.0" />

  <project path="hardware/lineage/interfaces"
           name="LineageOS/android_hardware_lineage_interfaces"
           remote="github"
           revision="lineage-23.2" />

  <project path="hardware/qcom-caf/common"
           name="LineageOS/android_hardware_qcom-caf_common"
           remote="github"
           revision="lineage-23.2">
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
  </project>

  <!-- SM8650 audio / display / data（Lineage CAF 路径，DT 硬编码） -->
  <project path="hardware/qcom-caf/sm8650/audio/agm"
           name="LineageOS/android_vendor_qcom_opensource_agm"
           remote="github"
           revision="lineage-23.2-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/audio/graphservices"
           name="LineageOS/android_vendor_qcom_opensource_audioreach-graphservices"
           remote="github"
           revision="lineage-23.2-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/audio/pal"
           name="LineageOS/android_vendor_qcom_opensource_arpal-lx"
           remote="github"
           revision="lineage-23.2-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/audio/primary-hal"
           name="LineageOS/android_hardware_qcom_audio-ar"
           remote="github"
           revision="lineage-23.2-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/data-ipa-cfg-mgr"
           name="LineageOS/android_vendor_qcom_opensource_data-ipa-cfg-mgr"
           remote="github"
           revision="lineage-23.2-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/dataipa"
           name="LineageOS/android_vendor_qcom_opensource_dataipa"
           remote="github"
           revision="lineage-23.2-caf-sm8650" />
  <project path="hardware/qcom-caf/sm8650/display"
           name="LineageOS/android_hardware_qcom_display"
           remote="github"
           revision="lineage-23.2-caf-sm8650" />

  <project path="vendor/qcom/opensource/audio-hal/st-hal-ar-legacy"
           name="LineageOS/android_vendor_qcom_opensource_audio-hal_st-hal-ar"
           remote="github"
           revision="lineage-23.2-legacy" />

  <!-- nubia vendor blob libcpion DT_NEEDED; AOSPA CLO 没有这份 -->
  <project path="vendor/qcom/opensource/libvmmem"
           name="LineageOS/android_vendor_qcom_opensource_libvmmem"
           remote="github"
           revision="lineage-23.2" />
</manifest>
