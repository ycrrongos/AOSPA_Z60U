# AOSPA cerro: Z60 Ultra has no 3.5mm jack. MTP "Headset Jack" reports
# SW_LINEOUT/PHYSICAL stuck high → AudioPolicy routes to phantom h2w/LINE.
# Primary fix is config_useDevInputEventForAudioJack=false; this is a backup clear.
on property:sys.boot_completed=1
    start cerro_clear_audio_jack

service cerro_clear_audio_jack /vendor/bin/cerro_clear_audio_jack.sh
    class late_start
    user root
    group system input
    oneshot
    disabled
