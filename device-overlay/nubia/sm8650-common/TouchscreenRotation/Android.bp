android_app {
    name: "TouchscreenRotation",
    // ArtistOS: vendor partition for A17 treble seapp + vendor_sysfs_touchpanel
    sdk_version: "system_current",
    certificate: "platform",
    privileged: true,
    vendor: true,

    srcs: [
        "src/**/*.kt",
    ],

    optimize: {
        enabled: false,
    },
}
